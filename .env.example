# Notara — local-first AI learning studio
#
# Nothing here is required to run `npm run dev`. The app uses PGlite in ./.data
# and local session cookies. Fill these in only when you switch to Supabase.

# --- Supabase (optional) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (optional) ---
# NVIDIA NIM is OpenAI-compatible. The key is read on the server only; leave it
# empty and Notara silently falls back to the deterministic local lesson engine.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT_MS=90000
# 0 = hidden reasoning off (fast). 1 = thinking on (slower, more tokens).
NVIDIA_THINKING=0
